  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/beallio/SDH-CssLoader/issues"
  },
  "homepage": "https://github.com/beallio/SDH-CssLoader#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/color": "^3.0.3",
    "@types/lodash": "^4.14.191",
    "@types/react": "16.14.0",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "color": "^4.2.3",
    "lodash": "^4.17.21",
    "react-icons": "^4.12.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
